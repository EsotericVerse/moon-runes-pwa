#!/bin/sh
# Local, zero-cost safety net: refuse to push if basic JS/TS syntax is
# broken. This exists because relying on the Cloudflare deploy pipeline
# (which auto-builds on every push to main) to catch a stray `{` burns
# real deploy minutes/cost for something that takes seconds to catch here.
#
# Enable once per clone: git config core.hooksPath .githooks

set -e
echo "pre-push: running npm run check:syntax (local, free, no CI/deploy involved)..."
node scripts/check-js-syntax.mjs

echo "pre-push: running check:bulk-delete (refuses mass delete/rename without confirmation)..."
node scripts/check-bulk-delete.mjs