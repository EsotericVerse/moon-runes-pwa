#!/bin/sh
# Local safety guard: a verified complete edit may skip the standalone syntax pass.
# Default stays conservative because interruption/recovery cannot be inferred from Git.
# Enable once per clone: git config core.hooksPath .githooks

set -e
if [ "${LOC_EDIT_STATE:-}" = "complete" ]; then
  echo "pre-push: complete edit confirmed by agent; skipping redundant syntax parse."
else
  echo "pre-push: edit/recovery completeness unconfirmed; checking syntax."
  node scripts/check-js-syntax.mjs
fi

echo "pre-push: checking mass deletion/rename safety..."
node scripts/check-bulk-delete.mjs
