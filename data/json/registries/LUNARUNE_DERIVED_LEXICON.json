{
  "version": "1.3-rc3",
  "title": "LunaRunes Derived Lexicon",
  "purpose": "只收錄會改變字面拆解判定、主體性或詞類的高價值衍生詞；不作一般同義詞字典，不回寫 Base66 Canon。",
  "governance": {
    "canonical_keywords_remain_narrow": true,
    "derived_terms_do_not_modify_canon": true,
    "special_is_default_when_unresolved": true,
    "discovery_scope": "先找自然存在且常用的 2 字符文組合；只保留主體性轉移、詞類轉移、第三符文歸屬或對等歧義，再延伸到 3–4 字。",
    "classification_order": [
      "詞類／句內語意角色",
      "群組主體性",
      "符文語意歸屬",
      "正反面／衝突校準"
    ],
    "highest_conflict_rule": "只有同一語意單位出現兩個以上有效符文候選時才啟動最高級衝突裁決。",
    "graph_projection": {
      "principle": "少量 Canon 與高價值衍生詞，透過關係投影擴張 Graph；不以大量同義詞灌資料。",
      "generated_nodes": [
        "lexical_class",
        "relation_type",
        "status"
      ],
      "generated_edges": [
        "surface_component_of",
        "surface_group",
        "cross_group_composition",
        "has_lexical_class",
        "uses_relation",
        "has_status",
        "resolved_to",
        "resolved_group",
        "ambiguous_with",
        "remains_special"
      ],
      "materialization": "runtime-derived",
      "source_of_truth": "Base66 Canon + LUNARUNE_DERIVED_LEXICON.json"
    },
    "whole_expression_precedence": "完整詞組的整體詞義與主體性優先於內部子詞；例如「日月星辰」不能因「星辰→星」就停在星。",
    "derived_keyword_rule": "超過 Canon 固定關鍵詞格式、但能穩定指向單一符文的固定詞或成語，列為衍生關鍵詞進 Graph，不回寫 Base66 Canon 關鍵詞。",
    "group_totality_resolution": "同組多符文形成整體後，不自動歸命；先判完整詞組的最高原則。若其中某符文本身就是該整體的最高統攝原則，主體歸該符文；若表達生命必然循環可歸命；若表達多力交互與不確定性可歸玄。",
    "highest_principle_rule": "完整詞組若存在能直接統攝整體語意的最高原則符文，該符文優先於一般群組總體提升。例：日月星辰皆為天體，最高原則歸星。"
  },
