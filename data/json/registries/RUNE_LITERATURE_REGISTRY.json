    "text": "required",
    "form": "prose | poem | lyric | fiction | quote | note | historical_text | other",
    "date": "YYYY-MM-DD or empty",
    "source_platform": "facebook | threads | suno | instagram | loc | other",
    "source_ref": "URL, source ID, file, post ID, work ID, or empty",
    "source_title": "optional",
    "author": "optional; default is not inferred",
    "tags": "array",
    "relation_note": "why this text is associated with the rune",
    "status": "recorded | reviewed | canonical_example",
    "created_at": "ISO timestamp"
  },
