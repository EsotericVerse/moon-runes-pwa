    "literature_is_canonical_definition": false,
    "rules": [
      "文學文本不得回寫或覆蓋符文 Canon 定義。",
      "只收錄有實際來源的作者文本、作品片段、詩句、歌詞意象、歷史寫法或明確整理稿。",
      "每筆 entry 必須保留來源、日期（若可得）與文體；未知欄位留空，不推測。",
      "同一文本可關聯多符，但每個 rune entry 保留獨立關聯理由。"
    ]
  },
  "entry_schema": {
    "entry_id": "RLIT-<rune_number>-<sequence>",
