      "owner": "source_management",
      "shared_base": true
    },
    {
      "feature": "content",
      "table": "content_registry",
      "owner": "content",
      "shared_base": true
    },
    {
      "feature": "actor",
      "table": "actor_registry",
      "owner": "authorship",
      "shared_base": true
    },
    {
      "feature": "projection",
      "table": "projection_registry",
      "owner": "governance",
      "shared_base": true
    },
    {
      "feature": "route",
      "table": "route_registry",
      "owner": "admin",
      "shared_base": true
    },
    {
      "feature": "page",
      "table": "page_registry",
      "owner": "admin",
      "shared_base": true
    },
    {
      "feature": "audit",
      "table": "audit_log",
      "owner": "admin",
      "shared_base": true
    }
