  "classification": {
    "confirmed": "Direct source record explicitly links a real draw to the song.",
    "high_candidate": "Strong multi-source match such as same date plus exact drawn-rune title, but missing explicit creation provenance.",
    "medium_candidate": "Temporal/contextual match to a known draw, but no direct rune linkage.",
    "rejected_theme_only": "Rune/moon/fate imagery without draw provenance.",
    "author_recalled": "Author recalls that rune songs were created using OW3gs 11-card draws, and identifies these candidates as likely belonging to that process. Stronger than metadata inference, but still distinct from a preserved original draw-to-song record.",
    "ow3gs_exact_11": "Exactly 11 distinct runes. These 11 runes are stored as the song's rune membership and surfaced by OW3gs/rune search.",
    "special_rune_song": "More than 11 distinct runes by deliberate special construction / rune-filling design; related to rune search but excluded from OW3gs 11-rune results."
  },
  "rules": [
    "Rune membership is counted by DISTINCT rune names; repeated occurrences of the same rune count once.",
    "Exactly 11 distinct runes are stored as OW3gs rune-song membership; no reverse guessing is required.",
    "Songs with more than 11 distinct runes may be special rune songs deliberately filled with rune vocabulary; keep them separate from OW3gs 11-rune results.",
    "Searching one rune may surface both OW3gs exact-11 rune songs and special rune songs that contain that rune.",
    "Searching OW3gs surfaces the OW3gs definition/method first, then related readings and exact-11 rune songs.",
    "Do not treat rune imagery alone as proof when no governed rune membership record exists.",
    "Explicit author rejection still overrides automatic keyword inference."
