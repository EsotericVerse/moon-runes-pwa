{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loc-isr",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "loc-isr"
    }
  ],
  "observability": {
    "enabled": true
  },
  "previews": {}
}
